# Copy this file to .env and fill in real values. Never commit .env.

GROQ_API_KEY=gsk_your_key_here

SAHARA_API_KEY=
SAHARA_BASE_URL=https://infer.voice.intron.io
DEFAULT_STT_PROVIDER=sahara
LOCAL_WHISPER_MODEL_SIZE=medium

VOICE_MATCH_THRESHOLD=0.85

# Paystack — account resolution and real NGN transfers. A live key only
# moves real money after the Paystack business account completes KYB.
PAYSTACK_SECRET_KEY=

# Optional. Set this to a Postgres connection string (e.g. Render's
# managed Postgres) and accounts/face/voice data persist across restarts
# instead of living only in memory — see app/services/db.py. Leave blank
# for local dev; nothing else changes when it's unset.
DATABASE_URL=
